# Cross-device sync via Firebase (optional). Leave these unset and the app runs
# fully local (progress in this browser only) — signing in is simply hidden.
#
# Get these from the Firebase console: Project settings -> Your apps -> Web app
# config. These values are PUBLIC by design; access is enforced by Firestore
# security rules (see firestore.rules), not by keeping the key secret.
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
